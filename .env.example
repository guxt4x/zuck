# Set private values in the ignored .env.local, never NEXT_PUBLIC_*.
DATABASE_URL=
# Optional direct connection for migration providers that require it.
DATABASE_URL_UNPOOLED=
LOG_LEVEL=info

# Groq (server only). Create a key in the Groq console; keep it in .env.local.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
